{
  "manifest_version": 3,
  "name": "Workflow Intelligence",
  "version": "1.0.0",
  "description": "Data collection and pattern detection engine for AI-native automation.",
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/interactionTracker.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Workflow Intelligence"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
